# Public DNS name pointing to this host; allow inbound TCP 80 and 443.
DOMAIN=monitor.example.invalid
# Put the panel behind Cloudflare Access, Tailscale, or Caddy basic_auth.
PANEL_DOMAIN=panel.example.invalid
# Optional: set a contact and enable the email block described in README.
ACME_EMAIL=
# Change if this subnet overlaps an existing Docker or host network.
WANGLOU_BACKEND_SUBNET=172.30.0.0/24
WANGLOU_TELEGRAM_TOKEN=
WANGLOU_TELEGRAM_CHAT_ID=
WANGLOU_WEBHOOK_URL=
WANGLOU_SERVER_IMAGE=zengxiang1/sand-monitor-server:latest
WANGLOU_AGENT_IMAGE=zengxiang1/sand-monitor-agent:latest

# Static status site; .localhost avoids requesting a public certificate by default.
STATUS_DOMAIN=status.localhost
# Billing dates, traffic reset days, availability and 09:00 reminders use this timezone.
WANGLOU_TIMEZONE=Asia/Shanghai
# Optional HTTPS heartbeat URL from an external monitoring service.
WANGLOU_HEARTBEAT_URL=
